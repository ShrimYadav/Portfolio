# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERPAPI_KEY: Optional API key for live Tech Radar searches via SerpApi.
# If not provided, the server gracefully serves cached & curated technology intelligence.
SERPAPI_KEY=""

# Email Notification Server Configuration (Optional)
# If provided, triggers SMTP email dispatch upon new portfolio contact inquiries.
CONTACT_EMAIL="shrimyadav777@gmail.com"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Admin Dashboard Access Secret (Optional override, defaults to secure local session)
ADMIN_SECRET_KEY="shrim-admin-2026"

